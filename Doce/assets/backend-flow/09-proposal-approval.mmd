flowchart TD
    A["运营：真实生成／编辑建议草稿"] --> B["运营：确认当前内容版本"]
    B --> C["运营：提交主管，pending_approval"]
    C --> D{"运营归档该版本？"}
    D -->|"是"| E["记录归档时间，退出审批，保留历史"]
    E -->|"需要调整"| A
    D -->|"否"| F["主管：核对版本与可用素材"]
    F --> G{"主管决定"}
    G -->|"驳回＋必填原因"| H["事务：rejected＋审批记录"]
    H --> A
    G -->|"批准"| I["事务：approved＋审批＋实验＋A/B"]
    I --> J["运营：模拟备注和经营回填"]
    I -->|"批准后调整"| A
    I --> K["批准版归档：保留已有实验与实绩"]
    classDef human fill:#e8f1ff,stroke:#3b73bf,color:#17385d;
    classDef transaction fill:#fff3dc,stroke:#b58b38,color:#634d25;
    class A,B,C,D,F,G,J human;
    class E,H,I,K transaction;
