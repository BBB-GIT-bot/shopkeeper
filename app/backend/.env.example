# 填写专用 MySQL 数据库连接；密码中的特殊字符须 URL 编码。
DATABASE_URL=mysql+pymysql://shopkeeper:replace-with-db-password@127.0.0.1:3306/shopkeeper?charset=utf8mb4
# SQLite 仅用于测试/旧课堂数据兼容，可显式改为 sqlite:///./shopkeeper.db。
JWT_SECRET=replace-with-local-secret
JWT_EXPIRES_SECONDS=28800
CONFIG_ENCRYPTION_KEY=replace-with-fernet-key
DEMO_OPERATOR_PASSWORD=operator123
DEMO_MANAGER_PASSWORD=manager123
# 文字模型地址、名称及密钥由主管在配置页维护；密钥以加密形式入库。
STORAGE_ROOT=./storage
